# Este projeto (a BASE) funciona 100% no navegador, sem backend.
# As variáveis abaixo só passam a valer quando você plugar um backend real
# (ver "Ligando um backend de verdade" no README.md).

# URL da API REST que vai substituir o armazenamento local.
VITE_API_URL=

# Exemplo para Turso/libSQL quando existir um servidor Node intermediário:
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
